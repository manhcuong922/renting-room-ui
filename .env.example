# Base URL của API (đã gồm /api/v1).
# Mặc định /api/v1 = CÙNG ORIGIN với trang → không có CORS:
#   - dev/preview: Vite proxy chuyển /api sang VITE_API_PROXY_TARGET
#   - production: web server reverse proxy /api sang backend (xem deploy/nginx.conf.example)
# Chỉ đặt URL tuyệt đối khi API ở domain khác; khi đó BE phải có origin của trang trong Cors:AllowedOrigins
# và URL phải là https nếu trang chạy https.
VITE_API_BASE_URL=/api/v1

# Backend mà proxy dev/preview trỏ tới (renting_room — launchSettings profile "http").
VITE_API_PROXY_TARGET=http://localhost:5213
